<?xml version="1.0" encoding="utf-8"?>
<!--
 The window background shown before the first Compose frame: black with a small terminal prompt
 glyph in the centre, so the native window already looks like the intro splash rather than a blank
 black rectangle.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/black" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_prompt" />
</layer-list>
