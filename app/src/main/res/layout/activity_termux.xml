<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Margins are applied to the terminal area inside the Compose shell (see ShellHost), not to
         this layout: insetting the shell would expose the terminal background colour over the bars. -->
    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="0dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/terminal_shell_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Keyboard-overlap probe, not a spacer: TermuxActivityRootView.onGlobalLayout() compares
             this view's window rect with the visible window and adds a bottom margin when the
             keyboard hides it (see the class comment). It overlays the shell's bottom edge instead
             of taking layout space, so it no longer shows a 1dp strip of the decor background (the
             terminal background colour) below the extra-keys bar. -->
        <View
            android:id="@+id/activity_termux_bottom_space_view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@android:color/transparent"
            android:importantForAccessibility="no" />

    </RelativeLayout>

</com.termux.app.terminal.TermuxActivityRootView>
