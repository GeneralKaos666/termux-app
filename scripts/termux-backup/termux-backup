#!/usr/bin/env bash
# termux-backup — back up and restore a Termux environment.
set -euo pipefail

SCRIPT_SOURCE=${BASH_SOURCE[0]}
while [ -L "$SCRIPT_SOURCE" ]; do
    SCRIPT_DIR=$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)
    SCRIPT_SOURCE=$(readlink "$SCRIPT_SOURCE")
    case $SCRIPT_SOURCE in
        /*) ;;
        *) SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE" ;;
    esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/storage.sh
source "$SCRIPT_DIR/lib/storage.sh"
# shellcheck source=lib/archive.sh
source "$SCRIPT_DIR/lib/archive.sh"
# shellcheck source=lib/report.sh
source "$SCRIPT_DIR/lib/report.sh"
# shellcheck source=lib/restore.sh
source "$SCRIPT_DIR/lib/restore.sh"

color_init

usage() {
    cat <<'EOF'
Usage: termux-backup <command> [options]

Commands:
  backup   Create a backup of packages, $HOME and $PREFIX/etc
  restore  Restore a backup
  list     List available backups
  verify   Verify a backup's checksums
  delete   Delete a backup
  prune    Keep only the newest N backups
  status   Show configuration and storage state

Global options:
  --json   Print one JSON object to stdout
  --quiet  Suppress progress output
  -h, --help  Show this help

Run "termux-backup <command> --help" for command options.
EOF
}


JSON=0
QUIET=0

if [ "$#" -eq 0 ]; then
    usage
    exit 1
fi

sub=$1
case $sub in
    -h | --help)
        usage
        exit 0
        ;;
    backup | restore | list | verify | delete | prune | status) ;;
    *)
        usage
        exit 1
        ;;
esac
shift

for arg in "$@"; do
    case $arg in
        --json) JSON=1 ;;
        --quiet) QUIET=1 ;;
    esac
done

if [ "$JSON" -eq 1 ] && [ "$QUIET" -eq 1 ]; then
    die 1 "--json and --quiet cannot be combined"
fi

rc=0
trap 'rc=$?; log_run "$sub" "$rc"; exit "$rc"' EXIT
"cmd_$sub" "$@"
